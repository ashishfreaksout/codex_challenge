EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-google-maps-api-key

# Optional. Leave blank to use the bundled mock Bay Area 311 JSON.
# The endpoint should return an array of records containing latitude/longitude
# or a Socrata-style location object.
EXPO_PUBLIC_BAY_AREA_311_ENDPOINT=
EXPO_PUBLIC_SAN_JOSE_311_ENDPOINT=

# Prediction microservice used by the "AI Predicted Hotspots" view.
EXPO_PUBLIC_PREDICTION_SERVICE_URL=https://ashishfreaksout-bay-area-pothole-prediction-api.hf.space

# Native APK map base layer. Use "osm" for OpenStreetMap tiles or "google"
# after a production Google Maps Android SDK key is working.
EXPO_PUBLIC_NATIVE_TILE_PROVIDER=osm

# Local development override:
# EXPO_PUBLIC_PREDICTION_SERVICE_URL=http://localhost:4000
# To preview the PostGIS-backed data engineering service in the existing
# AI Predicted Hotspots tab, run data_service/main.py and use:
# EXPO_PUBLIC_PREDICTION_SERVICE_URL=http://localhost:8000

# Optional. Shows the in-app "Test drive" simulator in production builds.
# Dev builds show it automatically.
EXPO_PUBLIC_ENABLE_SANDBOX_DRIVER=false

# Optional. Builds the separate 3D sandbox navigation APK with joystick controls.
EXPO_PUBLIC_ENABLE_3D_SANDBOX_NAVIGATION=false

# Geospatial data engineering layer.
# Docker Compose exposes PostGIS on host port 5433 to avoid conflicts with
# other local Postgres projects using 5432.
ROAD_RISK_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/road_risk

# Optional live ingestion sources. Leave blank to skip gracefully.
SAN_JOSE_311_API_URL=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
