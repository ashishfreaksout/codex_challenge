{
  "name": "bay-area-pothole-tracker",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "export:web:pages": "expo export --platform web --output-dir dist --clear && node scripts/prepare_pages_export.js dist",
    "predictive:train": "python3 ml/train_pothole_risk_model.py --input data/sample_bay_area_311_potholes.csv --environmental-features data/sample_bay_area_environmental_features.csv --output predictive-service/data/risk_grid.geojson --grid-size-meters 300 --max-environment-distance-m 9000",
    "predictive:serve": "node predictive-service/src/server.js",
    "postgis:up": "docker compose up -d postgis",
    "postgis:logs": "docker compose logs -f postgis",
    "data:fetch:311:demo": ".venv/bin/python ingestion/fetch_sanjose_311.py --demo",
    "data:fetch:osm": ".venv/bin/python ingestion/fetch_osm_roads.py --from-potholes data/raw/sanjose_311_potholes.json",
    "data:fetch:osm:bay-area": ".venv/bin/python ingestion/fetch_osm_roads.py --from-potholes data/sample_bay_area_311_potholes.csv --around-potholes --output data/raw/osm_roads_bay_area.json",
    "data:load": ".venv/bin/python ingestion/load_to_postgis.py --init-schema",
    "data:load:bay-area-demo": ".venv/bin/python ingestion/load_to_postgis.py --init-schema --potholes data/sample_bay_area_311_potholes.csv --osm-roads data/raw/osm_roads_bay_area.json --pothole-source \"Bay Area 311 sample\"",
    "data:refresh:bay-area-demo": "npm run data:load:bay-area-demo && npm run data:transform",
    "data:transform": ".venv/bin/python transformations/build_road_risk_features.py",
    "data:api": ".venv/bin/uvicorn data_service.main:app --reload --port 8000"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.10",
    "@react-google-maps/api": "^2.20.7",
    "cors": "^2.8.5",
    "expo": "~55.0.0",
    "expo-location": "~55.1.2",
    "expo-status-bar": "~55.0.4",
    "express": "^4.19.2",
    "lucide-react-native": "^1.11.0",
    "rbush": "^4.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-maps": "1.27.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "0.21.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0"
  }
}
